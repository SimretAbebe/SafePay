# LIVE_MODE_AVAILABLE=False
SAFE_PAY_API_KEY=your-api-key-here

# Chapa Configuration (Test Mode)
CHAPA_SECRET_KEY=your-chapa-test-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_DEFAULT_CURRENCY=ETB
CHAPA_RETURN_URL=
CHAPA_REQUEST_TIMEOUT=10

