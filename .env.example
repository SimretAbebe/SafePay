# =============================================================================
# Database Configuration
# =============================================================================
DB_NAME=safepay
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# Redis & Celery Configuration
# =============================================================================
# REDIS_URL: Connection string for the Celery background task queue and results broker.
# REDIS_CACHE_URL: Connection string for application caching (e.g. rate limiting, health probes).
# In production, both can point to the same Redis instance (e.g. redis://redis.internal:6379/0).
# A running Celery background worker is required for asynchronous tasks (webhooks, reconciliation) to execute.
REDIS_URL=redis://localhost:6379/0
# Optional dedicated Redis cache URL (defaults to REDIS_URL if unset)
# REDIS_CACHE_URL=redis://localhost:6379/1

# =============================================================================
# Merchant & Core API Defaults
# =============================================================================
SAFE_PAY_API_KEY=your-dev-api-key-here
WEBHOOK_TARGET_URL=https://your-webhook-endpoint.example.com
WEBHOOK_SECRET=your-webhook-signing-secret
# ALLOW_PRIVATE_WEBHOOK_TARGETS=False
# LIVE_MODE_AVAILABLE=True
# API_DOCS_ENABLED=True

# =============================================================================
# Fake Provider (Testing & Sandbox)
# =============================================================================
# FAKE_PROVIDER_DELAY_MS=300
# FAKE_PROVIDER_SECRET=fake-secret-for-tests
# SIMULATOR_ENABLED=True

# =============================================================================
# Chapa Gateway Configuration (Test Mode)
# =============================================================================
CHAPA_SECRET_KEY=your-chapa-test-secret-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_DEFAULT_CURRENCY=ETB
# CHAPA_RETURN_URL=https://example.com/chapa/return
# CHAPA_REQUEST_TIMEOUT=10

# =============================================================================
# ArifPay Gateway Configuration (Sandbox Mode)
# =============================================================================
ARIFPAY_API_KEY=your-arifpay-sandbox-api-key
ARIFPAY_SANDBOX=True
ARIFPAY_BASE_URL=https://gateway.arifpay.net/api/sandbox
ARIFPAY_DEFAULT_CURRENCY=ETB
# ARIFPAY_RETURN_URL=https://example.com/arifpay/return
# ARIFPAY_SUCCESS_URL=https://example.com/arifpay/success
# ARIFPAY_ERROR_URL=https://example.com/arifpay/error
# ARIFPAY_CANCEL_URL=https://example.com/arifpay/cancel
# ARIFPAY_NOTIFY_URL=https://example.com/arifpay/notify
# ARIFPAY_REQUEST_TIMEOUT=10

# =============================================================================
# Background Reconciliation Configuration
# =============================================================================
# RECONCILE_SWEEP_SECONDS=60
# RECONCILE_FIRST_CHECK_DELAY_SECONDS=300
# RECONCILE_BACKOFF_SECONDS=60,120,300,900,3600,3600,3600,3600
# RECONCILE_MAX_ATTEMPTS=8
# RECONCILE_BATCH_SIZE=50
# RECONCILE_LEASE_SECONDS=120
# RECONCILE_JITTER=0.1
# RECONCILE_HEARTBEAT_URL=https://heartbeat.example.com/ping

# =============================================================================
# Review Queue & Alerting Configuration
# =============================================================================
# REVIEW_ALERT_COOLDOWN_SECONDS=300
# REVIEW_ALERT_SWEEP_SECONDS=900
# REVIEW_DIGEST_HOUR_UTC=6
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# =============================================================================
# Transactional Webhook Outbox Configuration
# =============================================================================
# OUTBOX_SWEEP_SECONDS=30
# OUTBOX_BATCH_SIZE=100
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_RETENTION_DAYS=14

# =============================================================================
# Payment Expiry Configuration
# =============================================================================
# PAYMENT_EXPIRY_SECONDS=86400
# PAYMENT_EXPIRY_MIN_SECONDS=900
# PAYMENT_EXPIRY_MAX_SECONDS=604800
# EXPIRY_GRACE_SECONDS=900
# EXPIRY_SWEEP_SECONDS=60
# EXPIRY_BATCH_SIZE=50

# =============================================================================
# Health & Readiness Probes
# =============================================================================
# HEALTH_CACHE_SECONDS=5
# HEALTH_CHECK_TIMEOUT_SECONDS=2
# HEALTH_TOKEN=optional-bearer-token-for-health
# HEALTH_RECONCILE_STALE_SECONDS=300
# HEALTH_THROTTLE_RATE=120/minute

# =============================================================================
# Circuit Breaker Configuration
# =============================================================================
# BREAKER_ENABLED=True
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_WINDOW_SECONDS=60
# BREAKER_COOLDOWN_SECONDS=60
# BREAKER_MAX_COOLDOWN_SECONDS=600
# BREAKER_PROBE_TTL_SECONDS=30

# =============================================================================
# Server-Timing, Rate Limits & Diagnostics
# =============================================================================
# SERVER_TIMING_ENABLED=True
# SERVER_TIMING_DETAILED=False
# SLOW_REQUEST_MS=800
# PAYMENT_THROTTLE_RATE=100000/minute
# PAYMENT_READ_THROTTLE_RATE=100000/minute
# LEDGER_EXPORT_THROTTLE_RATE=10/minute
