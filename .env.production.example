# =============================================================================
# SafePay Production Environment Configuration Template
# All values below are placeholders. DO NOT commit actual secrets to version control.
# =============================================================================

# Security & Core Django Settings
DEBUG=False
# Production secret key (50+ random characters, never default/insecure)
SECRET_KEY=replace-with-a-secure-random-50-character-secret-key
# Comma-separated list of fully qualified domain names serving the API
ALLOWED_HOSTS=api.safepay.et,safepay.et

# HTTPS, SSL & Cookie Security
# Redirect all HTTP requests to HTTPS
SECURE_SSL_REDIRECT=True
# Ensure session cookies are transmitted only via HTTPS
SESSION_COOKIE_SECURE=True
# Ensure CSRF cookies are transmitted only via HTTPS
CSRF_COOKIE_SECURE=True
# HTTP Strict Transport Security duration in seconds (1 year)
SECURE_HSTS_SECONDS=31536000
# Apply HSTS to all subdomains
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Allow browser preloading of HSTS
SECURE_HSTS_PRELOAD=True

# Database Configuration (PostgreSQL)
DB_NAME=safepay_prod
DB_USER=safepay_app
DB_PASSWORD=replace-with-production-db-password
DB_HOST=postgres.internal.safepay.et
DB_PORT=5432

# Redis & Celery Message Broker
# Connection URL for production Redis instance
REDIS_URL=redis://redis.internal.safepay.et:6379/0
# Dedicated cache URL if separated from broker (optional, defaults to REDIS_URL)
REDIS_CACHE_URL=redis://redis.internal.safepay.et:6379/1

# Merchant Webhooks & API Keys
# Default signing secret for outbound webhook HMAC verification
WEBHOOK_SECRET=replace-with-production-webhook-signing-secret
# Admin API key for initial provisioning and diagnostics
SAFE_PAY_API_KEY=replace-with-production-safe-pay-api-key
# Reject webhook targets resolving to internal, loopback, or private IPs
ALLOW_PRIVATE_WEBHOOK_TARGETS=False

# Operational Modes & Safeguards
# Keep live mode strictly off until compliance and banking contracts are finalized
LIVE_MODE_AVAILABLE=False
# Keep staff simulator page off in production
SIMULATOR_ENABLED=False
# Enable or disable public OpenAPI Swagger documentation
API_DOCS_ENABLED=False

# Fake Provider (Sandbox Testing Only)
# Disabled in production
ENABLE_FAKE_PROVIDER=False
DEFAULT_PROVIDER=chapa

# Chapa Gateway Configuration (Production / Sandbox)
CHAPA_SECRET_KEY=replace-with-chapa-production-secret-key
CHAPA_WEBHOOK_SECRET=replace-with-chapa-webhook-secret
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_DEFAULT_CURRENCY=ETB
CHAPA_REQUEST_TIMEOUT=10
# Optional merchant redirect/return URL
# CHAPA_RETURN_URL=https://checkout.safepay.et/complete

# ArifPay Gateway Configuration (Production / Sandbox)
ARIFPAY_API_KEY=replace-with-arifpay-production-api-key
# Set to False when running against production gateway endpoints
ARIFPAY_SANDBOX=False
ARIFPAY_BASE_URL=https://api.arifpay.net/api
ARIFPAY_DEFAULT_CURRENCY=ETB
ARIFPAY_REQUEST_TIMEOUT=10

# Background Reconciliation Sweep Intervals
RECONCILE_SWEEP_SECONDS=60
RECONCILE_FIRST_CHECK_DELAY_SECONDS=300
RECONCILE_BACKOFF_SECONDS=60,120,300,900,3600,3600,3600,3600
RECONCILE_MAX_ATTEMPTS=8
RECONCILE_BATCH_SIZE=50
RECONCILE_LEASE_SECONDS=120
RECONCILE_JITTER=0.1
# External monitor ping URL for heartbeat alerts
RECONCILE_HEARTBEAT_URL=https://uptime.safepay.et/api/push/reconcile-heartbeat

# Review Queue & Operational Alerts
REVIEW_ALERT_COOLDOWN_SECONDS=300
REVIEW_ALERT_SWEEP_SECONDS=900
REVIEW_DIGEST_HOUR_UTC=6
TELEGRAM_BOT_TOKEN=replace-with-telegram-alert-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-alert-channel-id

# Transactional Webhook Outbox
OUTBOX_SWEEP_SECONDS=30
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=14

# Payment Expiry Settings
PAYMENT_EXPIRY_SECONDS=86400
PAYMENT_EXPIRY_MIN_SECONDS=900
PAYMENT_EXPIRY_MAX_SECONDS=604800
EXPIRY_GRACE_SECONDS=900
EXPIRY_SWEEP_SECONDS=60
EXPIRY_BATCH_SIZE=50

# Health & Readiness Probes
HEALTH_CACHE_SECONDS=5
HEALTH_CHECK_TIMEOUT_SECONDS=2
# Optional bearer token required to query health probe endpoints
HEALTH_TOKEN=replace-with-optional-health-check-bearer-token
HEALTH_RECONCILE_STALE_SECONDS=300
HEALTH_THROTTLE_RATE=120/minute

# Circuit Breaker Configuration
BREAKER_ENABLED=True
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_SECONDS=60
BREAKER_COOLDOWN_SECONDS=60
BREAKER_MAX_COOLDOWN_SECONDS=600
BREAKER_PROBE_TTL_SECONDS=30

# Latency, Diagnostics & Rate Limits
SERVER_TIMING_ENABLED=True
SERVER_TIMING_DETAILED=False
SLOW_REQUEST_MS=800
PAYMENT_THROTTLE_RATE=1000/minute
PAYMENT_READ_THROTTLE_RATE=2000/minute
LEDGER_EXPORT_THROTTLE_RATE=10/minute
